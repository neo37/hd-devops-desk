# Токен бота от @BotFather (обязателен)
HD_BOT_TOKEN=
# Адрес страницы заявок (hd.py), на него ведут ссылки входа
HD_PUBLIC=https://hd.example.org
# Каталог данных hd.py (outbox/, inbox/, chatlog/)
HD_STATE=./data
# Каталог состояния бота (devops.json, devops-links.json и др.), его же читает hd.py
HD_TG_STATE=./data/tg
# HTTPS-прокси для api.telegram.org, если он недоступен напрямую (необязательно)
#HD_TG_PROXY=http://user:pass@proxy.example.org:3128
